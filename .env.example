GROQ_API_KEY=                     # gsk_로 시작
GROQ_MODEL_FAST=openai/gpt-oss-20b    # 자연어 → 명령 (tool use)
GROQ_MODEL_SMART=openai/gpt-oss-120b  # 원인 요약

ANTHROPIC_API_KEY=                # 미사용 (나중에 provider 추가 시)
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5

TV_SESSION=                       # 선택. TradingView 쿠키 sessionid
TV_SIGNATURE=                     # 선택. TradingView 쿠키 sessionid_sign

BINANCE_API_KEY=                  # 조회 전용 (Enable Reading만)
BINANCE_API_SECRET=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
FINNHUB_API_KEY=

DB_PATH=./data/fivesigma.db
TZ=Asia/Seoul
LOG_LEVEL=info
