{
  "name": "5sigma-alert",
  "version": "0.1.0",
  "description": "TradingView 기반 Telegram 마켓 알림 봇 + 매매 기록",
  "scripts": {
    "dev": "tsx watch src/main.ts | pino-pretty --translateTime SYS:HH:MM:ss --ignore pid,hostname",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "service:install": "zsh scripts/launchd-install.sh",
    "service:uninstall": "zsh scripts/launchd-uninstall.sh",
    "service:restart": "zsh scripts/launchd-restart.sh",
    "service:logs": "tail -f ~/Library/Logs/5sigma-alert/out.log | pino-pretty --translateTime SYS:HH:MM:ss --ignore pid,hostname"
  },
  "type": "module",
  "dependencies": {
    "@mathieuc/tradingview": "^4.1.1",
    "better-sqlite3": "^13.0.3",
    "croner": "^11.0.0",
    "dotenv": "^18.0.10",
    "grammy": "^1.46.0",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
